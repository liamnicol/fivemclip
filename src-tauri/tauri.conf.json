{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FiveMClip",
  "version": "0.1.9",
  "identifier": "com.fivemclip.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FiveMClip",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/ffmpeg.exe": "bin/ffmpeg.exe"
    },
    "shortDescription": "Local clip recorder for FiveM",
    "longDescription": "Records the last few minutes of FiveM to your own drive, takes screenshots, and shares them without an account.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFODVEMkFGNTlFRUUxMEUKUldRTzRlNVpyOUtGWGlUbmlLK01oZ2JJd2d5amM0b2J5aGtCc2l6KzZFUTBZdVJQcEduK3FYbE8K",
      "endpoints": [
        "https://github.com/liamnicol/fivemclip/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
